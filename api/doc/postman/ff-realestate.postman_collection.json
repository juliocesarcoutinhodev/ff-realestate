{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "FF Realestate API",
    "description": "Coleção principal da FF Realestate API.\n\n**Autenticação**\nFaça o request *Auth › Login* para receber o token. O script de teste salva automaticamente o `accessToken` nas variáveis da coleção — todos os demais requests herdam o Bearer token.\n\n**Environments**\n- `local` → `http://localhost:8080`\n- `prod`  → URL de produção",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "description": "JWT de acesso. Estado de sessão — preenchido automaticamente pelo script do Login e limpo pelo Logout. Não pertence ao environment porque é idêntico em todos os ambientes.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "description": "Endpoints operacionais — não requerem autenticação.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Verifica se a API está em execução. Não requer autenticação."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status é UP', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.equal('UP');",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/api/v1/health" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"status\": \"UP\",\n    \"timestamp\": \"2025-01-01T12:00:00Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Autenticação e gerenciamento de sessão.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Autentica o usuário e retorna o access token. O script salva automaticamente o token na variável `accessToken` da coleção."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json?.data?.accessToken;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('accessToken', token);",
                  "        console.log('✅ accessToken salvo na coleção.');",
                  "    } else {",
                  "        console.warn('⚠️  accessToken não encontrado na resposta.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"success\": true,\n    \"message\": \"Login realizado com sucesso.\",\n    \"data\": {\n        \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n        \"tokenType\": \"Bearer\"\n    }\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"status\": 401,\n    \"error\": \"Unauthorized\",\n    \"message\": \"Credenciais inválidas.\",\n    \"timestamp\": \"2025-01-01T12:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Invalida o refresh token (cookie HttpOnly) e encerra a sessão."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    console.log('✅ accessToken removido da coleção.');",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "POST",
                "url": { "raw": "{{baseUrl}}/api/v1/auth/logout" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"success\": true,\n    \"message\": \"Logout realizado com sucesso.\",\n    \"data\": null\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Emite um novo access token usando o refresh token no cookie HttpOnly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json?.data?.accessToken;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('accessToken', token);",
                  "        console.log('✅ accessToken renovado.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
