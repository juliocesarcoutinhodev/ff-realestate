# =============================================
# Application
# =============================================
SPRING_PROFILES_ACTIVE=dev   # dev | prod

# =============================================
# Database
# =============================================
DB_NAME=fabricio_db
DB_URL=jdbc:postgresql://localhost:5432/fabricio_db   # local
# DB_URL=jdbc:postgresql://postgres:5432/fabricio_db  # inside Docker (prod)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =============================================
# JWT
# =============================================
JWT_SECRET=                                    # min 32 chars (256 bits) — obrigatório
JWT_EXPIRATION_MS=86400000          # 1 day in ms
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in ms

# =============================================
# MinIO
# =============================================

# Local (docker-compose.local.yml)
MINIO_ENDPOINT=http://localhost:9000

# Prod (shared MinIO on VPS)
# MINIO_ENDPOINT=https://storage.yourdomain.com.br

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ffrealestate

# Public base URL for generating file links (no trailing slash)
MINIO_PUBLIC_URL=http://localhost:9000              # local
# MINIO_PUBLIC_URL=https://storage.yourdomain.com.br # prod

# =============================================
# CORS
# =============================================

# Local
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# Prod
# ALLOWED_ORIGINS=https://fabriciofaceroli.com.br,https://admin.fabriciofaceroli.com.br

# =============================================
# Cookie
# =============================================
COOKIE_DOMAIN=localhost                         # local
# COOKIE_DOMAIN=.fabriciofaceroli.com.br        # prod

# =============================================
# Server (prod only)
# =============================================
PORT=8080
